@page "/Error"

<PageTitle>Erro</PageTitle>

<MudStack AlignItems="AlignItems.Center" Class="mt-12">
    <MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Error">Ocorreu um erro</MudText>
    <MudText>Não foi possível processar a requisição. Tente novamente.</MudText>
    <MudButton Href="/chamados" Variant="Variant.Text" Color="Color.Primary">Voltar para os chamados</MudButton>
</MudStack>
