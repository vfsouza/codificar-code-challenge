@page "/chamados/{Id:int}/editar"

<PageTitle>Editar chamado #@Id</PageTitle>

@if (_carregando) {
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
} else if (_model is null) {
    <ChamadoNaoEncontrado Id="Id"/>
} else {
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Editar chamado #@Id</MudText>

    <MudPaper Outlined="true" Class="pa-4">
        <ChamadoForm Model="_model"
                     Responsaveis="_responsaveis"
                     StatusDisponiveis="_statusDisponiveis"
                     Salvando="_salvando"
                     OnSalvar="SalvarAsync"
                     OnCancelar="Voltar"/>
    </MudPaper>
}
